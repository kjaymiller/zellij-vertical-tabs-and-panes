// Vertical tab bar on the RIGHT side
// Usage: zellij --layout vertical-tabs-right.kdl

keybinds {
    shared {
        // Toggle selectability (for resizing the pane)
        bind "Alt s" {
            MessagePlugin "file:~/.config/zellij/plugins/zellij-vertical-tabs-and-panes.wasm" {
                name "toggle_selectable"
            }
        }
    }
}

layout {
    pane split_direction="vertical" {
        pane
        pane size=18 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellij-vertical-tabs-and-panes.wasm" {
                // Name-only style (no numbers)
                format "#[fg=secondary]{name}"
                format_active "#[fg=accent]● {name}"
                max_name_length 15

                // Show panes under the active tab; click to focus
                show_panes "true"
                pane_format "#[fg=muted]  └ {title}"
                pane_format_active "#[fg=accent]  └ {title}"
            }
        }
    }
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
}
